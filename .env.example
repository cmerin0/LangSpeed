# LangSpeed environment configuration
# Copy this file to `.env` (cp .env.example .env) and adjust the values.
# docker compose reads `.env` automatically for variable substitution.
# NOTE: keep passwords simple (no `@`, `:` or `#`) - they are embedded in DATABASE_URL.

# ---------------------------------------------------------------------------
# Server runtime configuration (validated by the server at startup, R1.3/R1.4)
# ---------------------------------------------------------------------------
# Host + container port for the HTTP server (R1.5: defaults to 3000).
SERVER_PORT=3000

# JWT signing secret for the admin panel (R13.5). REQUIRED - replace with a long random value.
JWT_SECRET=92DRfYLLQYzKtSg0KNq2fwp9JWtaQq79DBOGIxSQx18

# Seed_Script credentials for the very first admin user (R2.8/R2.9). REQUIRED.
# If an admin already exists in the database these are ignored (R2.10).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ---------------------------------------------------------------------------
# Used only when running the server OUTSIDE Docker (cd server; go run ./cmd/server).
# Inside the compose network the server builds this URL from the POSTGRES_* values.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://langspeed:langspeed@localhost:5432/langspeed?sslmode=disable
REDIS_ADDR=localhost:6379

# ---------------------------------------------------------------------------
# Database container bootstrap (postgres image)
# ---------------------------------------------------------------------------
POSTGRES_USER=langspeed
POSTGRES_PASSWORD=langspeed
POSTGRES_DB=langspeed
